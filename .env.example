# HomeEase Customer Mobile App - Environment Configuration Example
# Do not commit real secrets or API keys to version control.
# Copy this file to .env or .env.local for local overrides.

# Frontend API configuration. Use HTTPS/WSS endpoints for production releases.
EXPO_PUBLIC_API_URL=http://3.107.161.126:8080/api/v1
EXPO_PUBLIC_TRACKING_API_URL=http://3.107.161.126:8082/api/v1
EXPO_PUBLIC_TRACKING_WS_URL=ws://3.107.161.126:8082/ws

# Google Maps API key for map rendering, geocoding, and address search.
# Set this variable in the EAS environment used for cloud builds as well.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
